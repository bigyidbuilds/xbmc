	<forum>https://forum.kodi.tv/showthread.php?tid=xxxx</forum> <!-- may be omitted -->
	<website></website> <!-- URL of the website that supplies the content, or the website for your plugin; may be omitted. -->
	<source>http://github.com/</source>
	<news>v0.0.1 (26/05/2026)
	  [new] some new feature
	  [fix] some fix
	</news>
	<assets>
		<icon>resources/icon.png</icon>
		<fanart>resources/fanart.jpg</fanart>
		<banner></banner> <!-- optional -->
		<clearlogo>resources/clearlogo.png</clearlogo> <!-- optional -->
